{
  "schema": {
    "name": "klorb-config",
    "version": "1.0.0"
  },
  "sessionDefaults": {
    "tools.maxCallsPerTurn": 150,
    "readDirs": {
      "deny": [],
      "ask": [],
      "allow": [
        "/home/aaron/src/klorb",
        "/home/dev/workspace/klorb"
      ]
    },
    "writeDirs": {
      "deny": [],
      "ask": [],
      "allow": [
        "/home/aaron/src/klorb",
        "/home/dev/workspace/klorb"
      ]
    },
    "commandRules": {
      "deny": [],
      "ask": [],
      "allow": [
        ["grep", "-i", "*"],
        ["make", "**"],
        ["bin/klorb", "--help"],
        ["venv/bin/python", "-m", "pytest", "**"],
        ["./venv/bin/python", "-m", "pytest", "**"],
        ["venv/bin/pytest", "**"],
        ["./venv/bin/pytest", "**"],
        ["venv/bin/python3", "-m", "pytest", "**"],
        ["./venv/bin/python3", "-m", "pytest", "**"],
        ["python", "-m", "pytest", "**"],
        ["python3", "-m", "pytest", "**"],
        ["sed", "-n", "*", "*"],
        ["grep", "-n", "*", "*"],
        ["venv/bin/isort", "**"],
        ["git", "stash"],
        ["git", "stash", "pop"],
        ["git", "diff", "**"],
        ["git", "status"],
        ["git", "status", "**"],
        ["git", "log", "**"],
        ["git", "-C", "*", "log", "--oneline", "-15", "--", "**"],
        ["source", "venv/bin/activate"],
        ["grep", "-E", "^(FAILED|PASSED|ERROR)"],
        ["find", "tests", "-name", "conftest.py"],
        ["./venv/bin/flake8", "--config", ".flake8", "src/klorb/sandbox.py"],
        ["grep", "-n", "klorb_dir\\|KLORB_DATA\\|KLORB_STATE\\|tiktoken\\|TIKTOKEN\\|local/share\\|local/state", "tests/test_sandbox.py"],
        ["grep", "-rn", "approved_scopes\\|EscalatePrivileges\\|escalate", "/home/aaron/src/klorb/docs/specs/permissions.md", "/home/aaron/src/klorb/docs/specs/projects-and-trust.md"],
        ["grep", "-E", "^(test|lint|mypy|flake|check|all):", "Makefile"],
        ["grep", "-nA2", "^typecheck:\\|^lint:\\|^test:", "Makefile"],
        ["venv/bin/flake8", "--config", ".flake8", "*"],
        ["python3", "--version"],
        ["which", "**"],
        ["head", "*", "*"],
        ["cat"],
        ["pip", "list"],
        ["pip", "show", "*"],
        ["sleep", "*"],
        ["grep", "-A", "*", "*"],
        ["tail", "*", "*"],
        ["markdownlint-cli2", "--config", "*", "*"],
        ["find", "/home/aaron/src/klorb/*", "-name", "*"],
        ["git", "show", "**"],
        ["git", "ls-files", "**"],
        ["git", "add", "**"],
        ["git", "commit", "**"],
        ["git", "mv", "**"],
        ["gh", "pr", "create", "**"]
      ]
    },
    "shareEnv": [
      "TIKTOKEN_CACHE_DIR"
    ],
    "skillRules": {
      "deny": [],
      "ask": [],
      "allow": [
        "workspace:implement-plan",
        "workspace:add-python-dependency",
        "workspace:add-cli-flag",
        "workspace:enable-software-factory",
        "internal:code-review",
        "workspace:add-openrouter-model",
        "workspace:vscode-plugin-architecture",
        "workspace:vscode-plugin-ui"
      ]
    },
    "webDomains": {
      "deny": [],
      "ask": [],
      "allow": [
        "openrouter.ai"
      ]
    },
    "bashDomains": {
      "deny": [],
      "ask": [],
      "allow": [
        "github.com",
        "openrouter.ai"
      ]
    }
  },
  "tools.logCalls": false,
  "hooks": {
    "onActivateSkill": [
      {
        "type": "bash",
        "name": "software-factory-enable-sentinel",
        "command": [
          "python3",
          "${workspaceRoot}/.klorb/hooks/software-factory/enable_sentinel.py"
        ],
        "filter": {
          "matches": "enable-software-factory"
        }
      }
    ],
    "onSessionEnd": [
      {
        "type": "bash",
        "name": "software-factory-disable-sentinel",
        "command": [
          "python3",
          "${workspaceRoot}/.klorb/hooks/software-factory/disable_sentinel.py"
        ],
        "filter": {
          "matches": "SuspendSession"
        }
      }
    ],
    "onAgentTurnEnd": [
      {
        "type": "bash",
        "name": "software-factory-turn-end",
        "command": [
          "python3",
          "${workspaceRoot}/.klorb/hooks/software-factory/on_turn_end.py"
        ]
      }
    ]
  },
  "events": {
    "FileSystemModified": [
      {
        "watch": "docs/plans/auto",
        "action": {
          "type": "bash",
          "name": "software-factory-file-changed",
          "command": [
            "python3",
            "${workspaceRoot}/.klorb/hooks/software-factory/on_file_changed.py"
          ]
        }
      }
    ]
  }
}
