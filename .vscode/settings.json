{
  "autopep8.args": [
    "--max-line-length",
    "105",
    "--ignore",
    "E114,E116,E128,E201,E202,E227,E261,E266,E303,N802,W391"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/*~": true,
    "**/venv": true,
    "**/*.swp": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "vscode-plugin/node_modules": true,
    "vscode-plugin/out": true,
  },
  "evenBetterToml.formatter.allowedBlankLines": 3,
  "evenBetterToml.formatter.indentEntries": true,
  "evenBetterToml.formatter.indentString": "  ",
  "python.defaultInterpreterPath": "${workspaceFolder}/klorb/venv",
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.cwd": "${workspaceFolder}/klorb",
  "python.analysis.typeCheckingMode": "standard",
  "python-envs.workspaceSearchPaths": [
    "${workspaceFolder}/klorb/venv",
  ],
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "makefile.makefilePath": "klorb/Makefile",
  "prettier.configPath": "vscode-plugin/.prettierrc.json",
  "prettier.ignorePath": "vscode-plugin/.prettierignore",
  "prettier.documentSelectors": [
    "**/*.{ts,js,tsx,jsx,cjs,mjs,css}"
  ],
  "js/ts.experimental.useTsgo": true,
  "search.exclude": {
    "*.vsix": true,
    "vscode-plugin/out/**": true
  },
  "prettier.printWidth": 100,
  "markdownlint.configFile": ".markdownlint-cli2.jsonc",
  "python.analysis.stubPath": "klorb/types",
}