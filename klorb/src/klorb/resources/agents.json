{
  "schema": {
    "name": "klorb-agents",
    "version": "1.0.0"
  },
  "agents": [
    {
      "name": "operator",
      "default_model": "xiaomi/mimo-v2.5-pro",
      "restrict_to": {
        "subagent_roles": [
          "explorer",
          "reviewer",
          "planner"
        ]
      },
      "allow_subagents": true,
      "agent_capabilities": {
        "accepts_tasks": true,
        "assigns_tasks": true,
        "see_group_tasks": true
      }
    },
    {
      "name": "planner",
      "default_model": "xiaomi/mimo-v2.5-pro",
      "restrict_to": {
        "tools": [
          "CreateFile",
          "EditFile",
          "ReadFile",
          "FindFile",
          "Grep",
          "ListDir",
          "CreateMemory",
          "EditMemory",
          "ListMemories",
          "SearchMemories",
          "ReadMemory",
          "ForgetMemory",
          "EditScratchpad",
          "ReadScratchpad",
          "SearchScratchpad",
          "CreateSubagent",
          "WaitForSubagent",
          "MessageSubagent",
          "WebFetch",
          "AskUserQuestions",
          "TodoCreate",
          "TodoList",
          "TodoNext",
          "TodoUpdate",
          "ActivateSkill",
          "ReadSkillFile",
          "SearchSkills"
        ],
        "skills": [
          "internal:write-plan",
          "internal:launch-explorer-subagent"
        ],
        "subagent_roles": [
          "explorer"
        ]
      },
      "allow_subagents": true,
      "agent_capabilities": {
        "accepts_tasks": false,
        "assigns_tasks": true,
        "see_group_tasks": true
      }
    },
    {
      "name": "reviewer",
      "default_model": "xiaomi/mimo-v2.5-pro",
      "restrict_to": {
        "subagent_roles": [
          "explorer"
        ]
      },
      "allow_subagents": true,
      "agent_capabilities": {
        "accepts_tasks": false,
        "assigns_tasks": true,
        "see_group_tasks": true
      }
    },
    {
      "name": "explorer",
      "default_model": "xiaomi/mimo-v2.5",
      "restrict_to": {
        "tools": [
          "FindFile",
          "Grep",
          "ListDir",
          "ReadFile",
          "ListMemories",
          "SearchMemories",
          "ReadMemory",
          "EditScratchpad",
          "ReadScratchpad",
          "WebFetch"
        ],
        "skills": [
          "internal:launch-explorer-subagent"
        ],
        "subagent_roles": [
          "explorer"
        ],
        "enforce_readonly_tools": true
      },
      "allow_subagents": true,
      "agent_capabilities": {
        "accepts_tasks": false,
        "assigns_tasks": false,
        "see_group_tasks": false
      }
    }
  ]
}