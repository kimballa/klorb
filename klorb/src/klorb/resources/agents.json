{
  "schema": {
    "name": "klorb-agents",
    "version": "1.0.0"
  },
  "agents": [
    {
      "name": "operator",
      "default_model": "klorb-default/normal",
      "max_copies": 1,
      "restrict_to": {
        "subagent_roles": [
          "explorer",
          "reviewer",
          "planner",
          "implementer",
          "pair_programmer"
        ]
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": true,
        "assigns_tasks": true,
        "see_group_tasks": true,
        "send_messages": true
      }
    },
    {
      "name": "implementer",
      "default_model": "klorb-default/normal",
      "max_copies": 1,
      "restrict_to": {
        "subagent_roles": [
          "explorer"
        ]
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": true,
        "assigns_tasks": false,
        "see_group_tasks": true
      }
    },
    {
      "name": "planner",
      "default_model": "klorb-default/normal",
      "max_copies": 1,
      "restrict_to": {
        "tools": [
          "CreateFile",
          "EditFile",
          "ReplaceAll",
          "ReadFile",
          "FindFile",
          "Grep",
          "ListDir",
          "CreateMemory",
          "EditMemory",
          "ListMemories",
          "SearchMemories",
          "ReadMemory",
          "ForgetMemory",
          "EditScratchpad",
          "ReadScratchpad",
          "SearchScratchpad",
          "CreateSubagent",
          "WaitForSubagent",
          "SendMessage",
          "GetMessages",
          "WebFetch",
          "AskUserQuestions",
          "TodoCreate",
          "TodoList",
          "TodoNext",
          "TodoUpdate",
          "ActivateSkill",
          "ReadSkillFile",
          "SearchSkills",
          "SearchTools"
        ],
        "skills": [
          "internal:write-plan",
          "internal:launch-explorer-subagent"
        ],
        "subagent_roles": [
          "explorer"
        ]
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": false,
        "assigns_tasks": true,
        "see_group_tasks": true,
        "send_messages": true
      }
    },
    {
      "name": "reviewer",
      "default_model": "klorb-default/normal",
      "max_copies": 1,
      "restrict_to": {
        "subagent_roles": [
          "explorer"
        ]
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": false,
        "assigns_tasks": true,
        "see_group_tasks": true,
        "send_messages": true
      }
    },
    {
      "name": "explorer",
      "default_model": "klorb-default/fast",
      "max_copies": null,
      "restrict_to": {
        "tools": [
          "FindFile",
          "Grep",
          "ListDir",
          "ReadFile",
          "ListMemories",
          "SearchMemories",
          "ReadMemory",
          "EditScratchpad",
          "ReadScratchpad",
          "WebFetch",
          "GetMessages",
          "PostChat",
          "ReadChat"
        ],
        "skills": [
          "internal:launch-explorer-subagent"
        ],
        "subagent_roles": [
          "explorer"
        ],
        "enforce_readonly_tools": true
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": false,
        "assigns_tasks": false,
        "see_group_tasks": false
      }
    },
    {
      "name": "pair_programmer",
      "default_model": "klorb-default/normal",
      "max_copies": 1,
      "restrict_to": {
        "subagent_roles": [
          "explorer"
        ]
      },
      "agent_capabilities": {
        "allow_subagents": true,
        "accepts_tasks": false,
        "assigns_tasks": true,
        "see_group_tasks": true,
        "send_messages": true
      },
      "events": {
        "FileSystemModified": [
          {
            "watch": ".",
            "applyGitignore": true,
            "action": {
              "type": "chat",
              "prompt": "Files in the workspace changed. Run `git status --short` and `git diff` to see what the Operator actually touched, then read the changed file(s) and any nearby code you need to judge them well. If the change is routine and matches the design you agreed on, don't say anything -- just note it and go back to waiting. If you spot a bug, a departure from the agreed design, a missing test, or anything else worth flagging, send the Operator a SendMessage naming the specific file and line. Don't edit anything yourself."
            }
          }
        ]
      }
    }
  ]
}
