{
  "name": "klorb-vscode",
  "displayName": "Klorb",
  "description": "Klorb agent harness session panel for VS Code",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Aaron Kimball",
    "email": "akimball83@gmail.com"
  },
  "publisher": "kimballa",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimballa/klorb.git",
    "directory": "vscode-plugin"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "klorb",
          "title": "Klorb",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "klorb": [
        {
          "type": "webview",
          "id": "klorb.sessionView",
          "name": "Session"
        }
      ]
    },
    "commands": [
      {
        "command": "klorb.newSession",
        "title": "Klorb: New Session"
      },
      {
        "command": "klorb.browseSessions",
        "title": "Klorb: Browse Recent Sessions"
      },
      {
        "command": "klorb.restartServer",
        "title": "Klorb: Restart Server"
      },
      {
        "command": "klorb.toggleTaskPanel",
        "title": "Klorb: Toggle Task Panel"
      },
      {
        "command": "klorb.selectModel",
        "title": "Klorb: Select Model"
      },
      {
        "command": "klorb.setThinking",
        "title": "Klorb: Set Thinking"
      },
      {
        "command": "klorb.cyclePermissionMode",
        "title": "Klorb: Cycle Permission Mode"
      },
      {
        "command": "klorb.setPermissionMode",
        "title": "Klorb: Set Permission Mode"
      },
      {
        "command": "klorb.showSessionStats",
        "title": "Klorb: Show Session Stats"
      },
      {
        "command": "klorb.reloadSkills",
        "title": "Klorb: Reload Skills"
      },
      {
        "command": "klorb.setOpenRouterApiKey",
        "title": "Klorb: Set OpenRouter API Key"
      },
      {
        "command": "klorb.clearOpenRouterApiKey",
        "title": "Klorb: Clear OpenRouter API Key"
      }
    ],
    "configuration": {
      "title": "Klorb",
      "properties": {
        "klorb.serverPath": {
          "type": "string",
          "default": "klorb",
          "description": "Path to the `klorb` command used to launch `klorb server`."
        },
        "klorb.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to an additional klorb-config.json file, passed to `klorb server` as `--config` when non-empty."
        },
        "klorb.resumeLatestSession": {
          "type": "boolean",
          "default": true,
          "description": "When opening the Klorb panel, resume the most recently used session for this workspace instead of always starting a new one."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsgo -p ./ && tsgo -p tsconfig.webview.json",
    "copy:codicons": "mkdir -p out/media && cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf out/media/",
    "build:extension": "esbuild src/extension.ts --tsconfig=tsconfig.json --bundle --sourcemap --outfile=out/extension.js --format=cjs --platform=node --target=es2022 --external:vscode",
    "build:webview": "node build-webview.mjs",
    "compile": "npm run typecheck && npm run copy:codicons && npm run build:extension && npm run build:webview",
    "build:extension:prod": "esbuild src/extension.ts --tsconfig=tsconfig.json --bundle --minify --sourcemap=linked --sources-content=false --legal-comments=linked --outfile=out/extension.js --format=cjs --platform=node --target=es2022 --external:vscode",
    "build:webview:prod": "node build-webview.mjs --prod",
    "compile:prod": "npm run typecheck && npm run copy:codicons && npm run build:extension:prod && npm run build:webview:prod",
    "watch": "tsgo -w -p ./",
    "lint": "eslint src test",
    "lint:fix": "prettier --config .prettierrc.json --cache --cache-location .prettier_cache --write --log-level warn src test types && eslint --fix src test",
    "test": "vitest run",
    "package": "vsce package --out klorb-vscode.vsix"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@chenglou/pretext": "^0.0.8",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vscode/vsce": "^3.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-babel": "^0.2.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "keytar@7.9.0": true,
    "unrs-resolver@1.12.2": true
  }
}
